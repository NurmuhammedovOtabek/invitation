# Environment Configuration Example
# Ushbu faylni .env nomi bilan nusxalang va o'z ma'lumotlaringizni kiriting!

# --- TELEGRAM BOT SOZLAMALARI ---
# @BotFather dan olingan bot tokeni
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Sizning shaxsiy Telegram ID raqamingiz (@userinfobot orqali bilib olish mumkin)
ADMIN_TELEGRAM_ID=123456789

# Mijozlar maxsus buyurtma uchun bog'lanishi mumkin bo'lgan Telegram username
ADMIN_USERNAME=tillo_dev

# --- TO'LOV MA'LUMOTLARI ---
CARD_NUMBER=8600 1234 5678 9012
CARD_HOLDER=FALONCHIYEV PISTONCHI
INVITATION_PRICE_UZS=50000

# --- SERVER VA HAVOLA SOZLAMALARI ---
# Saytingiz domeni (agar lokal bo'lsa: http://localhost:3000 yoki serverda: https://taklifnomangiz.uz)
BASE_URL=http://localhost:3000
PORT=3000
NODE_ENV=development
