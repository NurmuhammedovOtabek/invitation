<!DOCTYPE html>
<html lang="uz">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mijozga Maxsus Taklifnoma Yasash — Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <link rel="stylesheet" href="/css/animations.css">
  <style>
    body { background-color: #080c14; color: #f8fafc; }
  </style>
</head>
<body class="min-h-screen flex flex-col items-center justify-start selection:bg-amber-500 selection:text-slate-950 font-sans pb-16">

  <!-- HEADER -->
  <header class="w-full bg-slate-900/90 border-b border-slate-800 sticky top-0 z-30 backdrop-blur-md">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="/admin" class="p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-amber-400 border border-slate-700 transition-all">
          <i data-lucide="arrow-left" class="w-4 h-4"></i>
        </a>
        <div>
          <h1 class="font-serif-luxury font-bold text-lg text-white">Mijozga Maxsus Taklifnoma Yasash</h1>
          <p class="text-[11px] text-gray-400">Mijoz xohishi bo'yicha yasab, uning hisobiga biriktirib berish</p>
        </div>
      </div>

      <a href="/admin" class="text-xs text-gray-400 hover:text-white">Admin Panelga qaytish</a>
    </div>
  </header>

  <!-- FORM CONTAINER -->
  <main class="w-full max-w-4xl px-4 sm:px-6 pt-8">
    <form action="/admin/create" method="POST" enctype="multipart/form-data" class="bg-slate-900/90 border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-2xl space-y-6">
      
      <!-- 1. Target User Assignment (Mijozni tanlash yoki username kiritish) -->
      <div class="p-5 rounded-2xl bg-amber-500/10 border border-amber-500/30 space-y-3">
        <div class="flex items-center gap-2 text-amber-300 font-bold text-sm">
          <i data-lucide="user-check" class="w-5 h-5"></i>
          <span>1. Taklifnomani Qaysi Mijozga Biriktiramiz?</span>
        </div>
        <p class="text-xs text-gray-300">
          Ushbu taklifnoma saqlangach, to'g'ridan-to'g'ri o'sha mijozning shaxsiy kabinetiga qo'shiladi va unga Telegram bot orqali tayyor havola xabarnomasi boradi.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-1">
          <div>
            <label class="block text-xs text-gray-300 mb-1 font-semibold">Mijoz Telegram Username (masalan: @sardor_99):</label>
            <input type="text" name="target_username" placeholder="@username" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white text-xs focus:border-amber-400 focus:outline-none">
          </div>
          <div>
            <label class="block text-xs text-gray-300 mb-1 font-semibold">Yoki Ro'yxatdagi mavjud mijozni tanlang:</label>
            <select name="target_user_id" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white text-xs focus:border-amber-400 focus:outline-none">
              <option value="">-- Ro'yxatdan tanlash (ixtiyoriy) --</option>
              <% users.forEach(u => { %>
                <option value="<%= u.telegram_id %>"><%= u.first_name %> (<%= u.username ? '@' + u.username : u.telegram_id %>)</option>
              <% }) %>
            </select>
          </div>
        </div>
      </div>

      <!-- 2. Event & Couple Details -->
      <div class="space-y-4">
        <h3 class="font-bold text-sm text-white flex items-center gap-2 border-b border-slate-800 pb-2">
          <i data-lucide="heart" class="w-4 h-4 text-amber-400"></i> 2. To'y / Tadbir Ma'lumotlari
        </h3>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs text-gray-300 mb-1 font-semibold">Kelin va Kuyov ismlari:</label>
            <input type="text" name="names" required value="Alisher & Madina" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white text-xs focus:border-amber-400 focus:outline-none">
          </div>
          <div>
            <label class="block text-xs text-gray-300 mb-1 font-semibold">Tadbir turi:</label>
            <select name="event_type" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white text-xs focus:border-amber-400 focus:outline-none">
              <option value="Nikoh To'yi">💍 Nikoh To'yi</option>
              <option value="Visol Oqshomi">🎉 Visol Oqshomi</option>
              <option value="Sunnat To'yi">🎈 Sunnat To'yi</option>
              <option value="Tug'ilgan Kun">🎂 Tug'ilgan Kun / Yubiley</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs text-gray-300 mb-1 font-semibold">To'y sanasi:</label>
            <input type="date" name="event_date" value="2026-10-25" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white text-xs focus:border-amber-400 focus:outline-none">
          </div>
          <div>
            <label class="block text-xs text-gray-300 mb-1 font-semibold">Boshlanish vaqti:</label>
            <input type="time" name="event_time" value="18:00" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white text-xs focus:border-amber-400 focus:outline-none">
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs text-gray-300 mb-1 font-semibold">To'yxona / Restoran nomi:</label>
            <input type="text" name="venue_name" value='"Yakkasaroy" To'\''yxonasi' class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white text-xs focus:border-amber-400 focus:outline-none">
          </div>
          <div>
            <label class="block text-xs text-gray-300 mb-1 font-semibold">Manzili:</label>
            <input type="text" name="venue_address" value="Toshkent shahri, Shota Rustaveli ko'chasi 54-uy" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white text-xs focus:border-amber-400 focus:outline-none">
          </div>
        </div>

        <div>
          <label class="block text-xs text-gray-300 mb-1 font-semibold">Yandex Xarita / Google Maps havolasi:</label>
          <input type="url" name="yandex_map_url" placeholder="https://yandex.com/maps/..." class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white text-xs focus:border-amber-400 focus:outline-none">
        </div>

        <div>
          <label class="block text-xs text-gray-300 mb-1 font-semibold">Maxsus Taklif Matni (Tilak):</label>
          <textarea name="custom_text" rows="3" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white text-xs focus:border-amber-400 focus:outline-none">Sizni va aziz oila a'zolaringizni farzandlarimizning baxt to'yiga lutfan taklif etamiz! Tashrifingiz biz uchun cheksiz sharafdir.</textarea>
        </div>
      </div>

      <!-- 3. Visual & Animation Design Choices -->
      <div class="space-y-4">
        <h3 class="font-bold text-sm text-white flex items-center gap-2 border-b border-slate-800 pb-2">
          <i data-lucide="palette" class="w-4 h-4 text-amber-400"></i> 3. Dizayn va Animatsiya Uslublari
        </h3>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs text-gray-300 mb-1 font-semibold">Ochilish Animatsiyasi:</label>
            <select name="opening_style" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white text-xs focus:border-amber-400 focus:outline-none">
              <option value="envelope_wax">✉️ 3D Muhrli Konvert</option>
              <option value="ribbon_gift">🎀 Lenta & Sovg'a Qutisi</option>
              <option value="curtain_reveal">🎭 Shohona Parda</option>
              <option value="fade_glow">✨ Yulduzli Porlash</option>
              <option value="direct">⚡️ To'g'ridan-to'g'ri (Ochilishsiz)</option>
            </select>
          </div>

          <div>
            <label class="block text-xs text-gray-300 mb-1 font-semibold">Rang Mavzusi:</label>
            <select name="theme_color" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white text-xs focus:border-amber-400 focus:outline-none">
              <option value="emerald_gold">👑 Emerald & Oltin (#0c3327)</option>
              <option value="#3d0c14">🍷 Bordo / To'q Qizil</option>
              <option value="midnight_blue">🌌 Midnight Blue (#0c1a30)</option>
              <option value="rose_blush">🌸 Rose Blush (Pushti)</option>
              <option value="#111111">🖤 Qora & Oltin</option>
              <option value="turquoise_festive">🎉 Feruza / Sunnat To'yi</option>
            </select>
          </div>

          <div>
            <label class="block text-xs text-gray-300 mb-1 font-semibold">Shrift (Typography):</label>
            <select name="font_family" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white text-xs focus:border-amber-400 focus:outline-none">
              <option value="great_vibes">✍️ Great Vibes (Kaligrafik)</option>
              <option value="playfair">📜 Playfair (Shohona)</option>
              <option value="cinzel">🏛 Cinzel (Rim Imperator)</option>
              <option value="alex_brush">💎 Alex Brush (Romantik)</option>
              <option value="cormorant">🖋 Cormorant Garamond</option>
            </select>
          </div>
        </div>
      </div>

      <!-- 4. Media Files (Mijoz bergan rasm va musiqa fayllari) -->
      <div class="space-y-4">
        <h3 class="font-bold text-sm text-white flex items-center gap-2 border-b border-slate-800 pb-2">
          <i data-lucide="music" class="w-4 h-4 text-amber-400"></i> 4. Rasmlar va Musiqa (Mijoz Bergan Fayllar)
        </h3>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 space-y-2">
            <label class="block text-xs text-gray-300 font-semibold flex items-center gap-1.5">
              <i data-lucide="image" class="w-4 h-4 text-amber-400"></i> Kelin-Kuyov Rasmini Yuklash:
            </label>
            <input type="file" name="photo_file" accept="image/*" class="text-xs text-gray-400 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-amber-500 file:text-slate-950 hover:file:bg-amber-400">
            <p class="text-[10px] text-gray-500">Yoki rasm URL: <input type="url" name="photo_url" placeholder="https://..." class="w-full mt-1 px-2.5 py-1.5 rounded-lg bg-slate-900 border border-slate-700 text-white text-xs"></p>
          </div>

          <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 space-y-2">
            <label class="block text-xs text-gray-300 font-semibold flex items-center gap-1.5">
              <i data-lucide="file-audio" class="w-4 h-4 text-amber-400"></i> Maxsus Musiqa (MP3) Yuklash:
            </label>
            <input type="file" name="audio_file" accept="audio/*" class="text-xs text-gray-400 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-amber-500 file:text-slate-950 hover:file:bg-amber-400">
            <p class="text-[10px] text-gray-500">Agar yuklanmasa, standart romantik musiqa qo'yiladi.</p>
          </div>
        </div>
      </div>

      <!-- 5. Toyona Card Details -->
      <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs text-gray-300 mb-1 font-semibold">💳 To'yona uchun karta raqami (ixtiyoriy):</label>
          <input type="text" name="card_number" placeholder="8600 0000 0000 0000" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-white font-mono text-xs focus:border-amber-400 focus:outline-none">
        </div>
        <div>
          <label class="block text-xs text-gray-300 mb-1 font-semibold">Karta egasi:</label>
          <input type="text" name="card_holder" placeholder="Kuyov yoki Kelin ismi" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-white text-xs focus:border-amber-400 focus:outline-none">
        </div>
      </div>

      <!-- Submit Button -->
      <div class="pt-4 border-t border-slate-800 flex items-center justify-between">
        <a href="/admin" class="text-xs text-gray-400 hover:text-white">Bekor qilish</a>
        <button type="submit" class="py-3 px-8 rounded-2xl bg-gold-luxury text-slate-950 font-bold text-xs shadow-lg shadow-amber-500/30 hover:brightness-110 active:scale-95 transition-all flex items-center gap-2">
          <i data-lucide="check" class="w-4 h-4"></i> Taklifnomani Yaratish va Mijozga Biriktirish
        </button>
      </div>

    </form>
  </main>

  <script>lucide.createIcons();</script>
</body>
</html>
