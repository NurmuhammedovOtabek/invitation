<!DOCTYPE html>
<html lang="uz">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Boshqaruv Paneli — Taklifnoma.uz</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <link rel="stylesheet" href="/css/animations.css">
  <style>
    body { background-color: #080c14; color: #f8fafc; }
    .custom-scroll::-webkit-scrollbar { width: 6px; }
    .custom-scroll::-webkit-scrollbar-track { background: #0f172a; }
    .custom-scroll::-webkit-scrollbar-thumb { background: #334155; border-radius: 4px; }
  </style>
</head>
<body class="min-h-screen flex flex-col items-center justify-start selection:bg-amber-500 selection:text-slate-950 font-sans pb-16">

  <!-- HEADER -->
  <header class="w-full bg-slate-900/90 border-b border-slate-800 sticky top-0 z-30 backdrop-blur-md">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-amber-500 to-amber-700 flex items-center justify-center text-slate-950 font-bold shadow-lg shadow-amber-500/20">
          <i data-lucide="shield-check" class="w-5 h-5"></i>
        </div>
        <div>
          <h1 class="font-serif-luxury font-bold text-lg text-white">Admin Boshqaruv Paneli</h1>
          <p class="text-[11px] text-gray-400">Taklifnomalar, To'lovlar, Sozlamalar va Sharhlar</p>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <a href="/admin/create" class="py-2.5 px-4 rounded-xl bg-gold-luxury text-slate-950 font-bold text-xs shadow-md shadow-amber-500/20 flex items-center gap-1.5 hover:brightness-110 active:scale-95 transition-all">
          <i data-lucide="plus-circle" class="w-4 h-4"></i> Mijozga Taklifnoma Yasab Berish
        </a>
        <a href="/dashboard" class="py-2.5 px-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-gray-300 text-xs border border-slate-700 flex items-center gap-1.5 transition-all">
          <i data-lucide="user" class="w-4 h-4 text-amber-400"></i> Kabinet
        </a>
      </div>
    </div>
  </header>

  <!-- MAIN CONTAINER -->
  <main class="w-full max-w-6xl px-4 sm:px-6 pt-8 space-y-8">
    
    <!-- Success Alert Message -->
    <% if (successMsg) { %>
      <div class="p-4 rounded-2xl bg-emerald-500/15 border border-emerald-500/40 text-emerald-300 text-xs font-semibold flex items-center gap-2.5 shadow-lg">
        <i data-lucide="check-circle" class="w-5 h-5 text-emerald-400 shrink-0"></i>
        <span><%= successMsg %></span>
      </div>
    <% } %>

    <!-- 1. STATS METRICS CARDS -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div class="p-5 rounded-3xl bg-slate-900/80 border border-slate-800 space-y-1">
        <span class="text-xs text-gray-400 flex items-center gap-1.5">
          <i data-lucide="users" class="w-4 h-4 text-amber-400"></i> Jami Foydalanuvchilar
        </span>
        <span class="text-2xl sm:text-3xl font-bold font-serif-luxury text-white block"><%= stats.usersCount %> nafar</span>
      </div>

      <div class="p-5 rounded-3xl bg-slate-900/80 border border-slate-800 space-y-1">
        <span class="text-xs text-gray-400 flex items-center gap-1.5">
          <i data-lucide="mail" class="w-4 h-4 text-blue-400"></i> Jami Taklifnomalar
        </span>
        <span class="text-2xl sm:text-3xl font-bold font-serif-luxury text-white block"><%= stats.invCount %> ta</span>
      </div>

      <div class="p-5 rounded-3xl bg-slate-900/80 border border-slate-800 space-y-1">
        <span class="text-xs text-gray-400 flex items-center gap-1.5">
          <i data-lucide="check-circle" class="w-4 h-4 text-emerald-400"></i> Faol (Sotilgan)
        </span>
        <span class="text-2xl sm:text-3xl font-bold font-serif-luxury text-emerald-400 block"><%= stats.activeInvCount %> ta</span>
      </div>

      <div class="p-5 rounded-3xl bg-slate-900/80 border border-slate-800 space-y-1">
        <span class="text-xs text-gray-400 flex items-center gap-1.5">
          <i data-lucide="dollar-sign" class="w-4 h-4 text-amber-400"></i> Jami Tushum
        </span>
        <span class="text-2xl sm:text-3xl font-bold font-serif-luxury text-amber-300 block"><%= stats.totalEarnings.toLocaleString() %> so'm</span>
      </div>
    </div>

    <!-- 2. QUICK ACTION & SETTINGS SECTION -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <!-- System Settings Box (Karta raqami va narxni dinamik o'zgartirish) -->
      <div class="p-6 rounded-3xl bg-slate-900/90 border border-slate-800 space-y-5 lg:col-span-1">
        <div class="flex items-center gap-2 border-b border-slate-800 pb-3">
          <i data-lucide="sliders" class="w-5 h-5 text-amber-400"></i>
          <h2 class="font-bold text-sm text-white">To'lov va Tizim Sozlamalari</h2>
        </div>

        <form action="/admin/settings" method="POST" class="space-y-4">
          <div>
            <label class="block text-xs text-gray-300 mb-1 font-semibold">💳 To'lov Karta Raqami:</label>
            <input type="text" name="card_number" value="<%= settings.card_number || '8600 0000 0000 0000' %>" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white font-mono text-xs focus:border-amber-400 focus:outline-none">
          </div>

          <div>
            <label class="block text-xs text-gray-300 mb-1 font-semibold">👤 Karta Egasi (Ism-Familiya):</label>
            <input type="text" name="card_holder" value="<%= settings.card_holder || 'ADMINISTRATOR' %>" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white text-xs focus:border-amber-400 focus:outline-none">
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs text-gray-300 mb-1 font-semibold">💰 Taklifnoma Narxi:</label>
              <input type="number" name="invitation_price" value="<%= settings.invitation_price || '50000' %>" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white text-xs focus:border-amber-400 focus:outline-none">
            </div>
            <div>
              <label class="block text-xs text-gray-300 mb-1 font-semibold">✈️ Admin Username:</label>
              <input type="text" name="admin_username" value="<%= settings.admin_username || 'admin' %>" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white text-xs focus:border-amber-400 focus:outline-none">
            </div>
          </div>

          <div>
            <label class="block text-xs text-gray-300 mb-1 font-semibold">📞 Aloqa Telefoni:</label>
            <input type="text" name="support_phone" value="<%= settings.support_phone || '+998 90 000 00 00' %>" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white text-xs focus:border-amber-400 focus:outline-none">
          </div>

          <button type="submit" class="w-full py-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs shadow-md shadow-amber-500/20 active:scale-95 transition-all">
            💾 Sozlamalarni Saqlash
          </button>
        </form>
      </div>

      <!-- Quick Custom Invitation Creator CTA & Recent Invitations -->
      <div class="p-6 rounded-3xl bg-slate-900/90 border border-slate-800 space-y-4 lg:col-span-2 flex flex-col justify-between">
        <div class="space-y-3">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <div class="flex items-center gap-2">
              <i data-lucide="layers" class="w-5 h-5 text-amber-400"></i>
              <h2 class="font-bold text-sm text-white">Yaratilgan Taklifnomalar Ro'yxati</h2>
            </div>
            <a href="/admin/create" class="text-xs text-amber-400 hover:underline flex items-center gap-1 font-semibold">
              <i data-lucide="plus" class="w-3.5 h-3.5"></i> Yangi yaratish
            </a>
          </div>

          <div class="space-y-2.5 max-h-[340px] overflow-y-auto custom-scroll pr-1">
            <% if (allInvitations.length === 0) { %>
              <p class="text-xs text-gray-500 text-center py-8">Hali taklifnomalar yaratilmagan.</p>
            <% } else { %>
              <% allInvitations.forEach(inv => { %>
                <div class="p-3.5 rounded-2xl bg-slate-950/80 border border-slate-800 flex items-center justify-between gap-3">
                  <div class="space-y-0.5">
                    <div class="flex items-center gap-2">
                      <span class="text-xs font-bold text-white"><%= inv.groom_name %></span>
                      <% if (inv.created_by_admin === 1) { %>
                        <span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-purple-500/20 text-purple-300 border border-purple-500/30">👑 Admin Yasagan</span>
                      <% } %>
                    </div>
                    <p class="text-[11px] text-gray-400">Mijoz: <%= inv.username ? '@' + inv.username : (inv.first_name || inv.user_id) %> • Sana: <%= inv.event_date %></p>
                  </div>

                  <div class="flex items-center gap-2">
                    <a href="/i/<%= inv.id %>" target="_blank" class="p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-amber-300 text-xs" title="Ochish">
                      <i data-lucide="external-link" class="w-4 h-4"></i>
                    </a>
                    <form action="/admin/invitations/delete/<%= inv.id %>" method="POST" onsubmit="return confirm('Rostdan ham ushbu taklifnomani o\'chirmoqchimisiz?');">
                      <button type="submit" class="p-2 rounded-xl bg-red-950/40 hover:bg-red-900/60 text-red-400 text-xs border border-red-800/40" title="O'chirish">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                      </button>
                    </form>
                  </div>
                </div>
              <% }) %>
            <% } %>
          </div>
        </div>

        <div class="pt-4 border-t border-slate-800">
          <a href="/admin/create" class="w-full py-3.5 rounded-2xl bg-gradient-to-r from-amber-500 to-amber-600 text-slate-950 font-bold text-xs shadow-lg shadow-amber-500/20 flex items-center justify-center gap-2 hover:brightness-110 active:scale-95 transition-all">
            <i data-lucide="wand-2" class="w-4 h-4"></i> Mijoz Xohishiga Ko'ra Maxsus Taklifnoma Yasash Formasini Ochish
          </a>
        </div>
      </div>

    </div>

    <!-- 3. REVIEWS MANAGEMENT SECTION (Sharhlar) -->
    <div class="p-6 rounded-3xl bg-slate-900/90 border border-slate-800 space-y-5">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <div class="flex items-center gap-2">
          <i data-lucide="star" class="w-5 h-5 text-amber-400"></i>
          <h2 class="font-bold text-sm text-white">Mijozlar Qoldirgan Sharhlar (<%= reviews.length %> ta)</h2>
        </div>
        <span class="text-xs text-gray-400">Sayt va botda ko'rinadigan fikrlar</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3.5 max-h-[400px] overflow-y-auto custom-scroll pr-1">
        <% if (reviews.length === 0) { %>
          <div class="col-span-full py-8 text-center text-xs text-gray-500">
            Hozircha sharhlar mavjud emas.
          </div>
        <% } else { %>
          <% reviews.forEach(rev => { %>
            <div class="p-4 rounded-2xl bg-slate-950/80 border border-slate-800 space-y-2.5 flex flex-col justify-between">
              <div class="space-y-1.5">
                <div class="flex items-center justify-between">
                  <span class="font-bold text-xs text-white"><%= rev.author_name %></span>
                  <div class="flex text-amber-400 text-xs">
                    <% for(let i=0; i<rev.rating; i++) { %>★<% } %>
                  </div>
                </div>
                <p class="text-xs text-gray-300 italic">"<%= rev.comment %>"</p>
                <span class="text-[10px] text-gray-500 block"><%= rev.created_at %> • Manba: <%= rev.source %></span>
              </div>

              <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-800/60">
                <form action="/admin/reviews/delete/<%= rev.id %>" method="POST" onsubmit="return confirm('Ushbu sharhni o\'chirmoqchimisiz?');">
                  <button type="submit" class="px-3 py-1 rounded-lg bg-red-950/40 text-red-400 border border-red-800/40 text-[11px] font-semibold hover:bg-red-900/60 transition-all">
                    O'chirish
                  </button>
                </form>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>

  </main>

  <script>lucide.createIcons();</script>
</body>
</html>
