<!DOCTYPE html>
<html lang="uz">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shaxsiy Kabinetga Kirish — Online Taklifnomalar</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- Telegram WebApp SDK for Auto-Login -->
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
  <link rel="stylesheet" href="/css/animations.css">
</head>
<body class="min-h-screen bg-slate-950 text-slate-100 flex items-center justify-center p-4 selection:bg-amber-500 selection:text-slate-950 font-sans">

  <div class="w-full max-w-md bg-slate-900/90 border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-2xl shadow-amber-500/10 text-center space-y-6">
    
    <!-- Brand Icon -->
    <div class="w-16 h-16 rounded-2xl bg-gold-luxury text-slate-950 flex items-center justify-center mx-auto shadow-lg shadow-amber-500/30">
      <i data-lucide="shield-check" class="w-8 h-8"></i>
    </div>

    <div class="space-y-2">
      <h1 class="font-serif-luxury font-bold text-2xl text-white">Shaxsiy Kabinet</h1>
      <p class="text-xs text-gray-400">Taklifnomalaringiz tarixi, havolalar va ko'rishlar statistikasini kuzatib boring</p>
    </div>

    <!-- WebApp Auto Login Status Box (shown when inside Telegram) -->
    <div id="webapp-status" class="hidden p-4 rounded-2xl bg-amber-500/10 border border-amber-500/30 space-y-2">
      <div class="w-6 h-6 border-2 border-amber-400 border-t-transparent rounded-full animate-spin mx-auto"></div>
      <p class="text-xs text-amber-300 font-semibold">Telegram hisobingiz aniqlanmoqda...</p>
    </div>

    <!-- Regular Browser Login Options -->
    <div id="browser-login-options" class="space-y-4">
      
      <!-- Option 1: 1-Click Telegram Deep Link Login -->
      <a href="https://t.me/<%= botUsername %>?start=auth_<%= sessionCode %>" target="_blank" class="w-full py-4 px-6 rounded-2xl bg-gradient-to-r from-sky-500 to-blue-600 hover:from-sky-400 hover:to-blue-500 text-white font-bold text-sm shadow-xl shadow-sky-500/20 flex items-center justify-center gap-3 active:scale-95 transition-all">
        <i data-lucide="send" class="w-5 h-5"></i> Telegram orqali 1 ta bosishda kirish
      </a>

      <div class="relative flex py-2 items-center">
        <div class="flex-grow border-t border-slate-800"></div>
        <span class="flex-shrink mx-4 text-xs text-gray-500 uppercase tracking-widest">Yoki</span>
        <div class="flex-grow border-t border-slate-800"></div>
      </div>

      <!-- Option 2: Test / Demo Quick Access -->
      <button onclick="demoLogin()" class="w-full py-3 px-4 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs font-semibold text-gray-300 flex items-center justify-center gap-2 transition-all">
        <i data-lucide="user" class="w-4 h-4 text-amber-400"></i> Demo hisob bilan kirish (Sinov)
      </button>

      <p class="text-[11px] text-gray-500">
        Telegram havolasini bosishingiz bilan bot sizni avtomatik tasdiqlaydi va ushbu sahifa to'g'ridan-to'g'ri ochiladi.
      </p>
    </div>

    <div class="pt-4 border-t border-slate-800/80">
      <a href="/" class="text-xs text-amber-400 hover:underline inline-flex items-center gap-1">
        <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i> Asosiy sahifaga qaytish
      </a>
    </div>

  </div>

  <script>
    lucide.createIcons();

    const sessionCode = '<%= sessionCode %>';

    // 1. Check if inside Telegram WebApp
    if (window.Telegram && window.Telegram.WebApp && window.Telegram.WebApp.initDataUnsafe && window.Telegram.WebApp.initDataUnsafe.user) {
      document.getElementById('webapp-status').classList.remove('hidden');
      document.getElementById('browser-login-options').classList.add('hidden');

      const tgUser = window.Telegram.WebApp.initDataUnsafe.user;
      
      fetch('/api/auth/webapp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          id: tgUser.id,
          first_name: tgUser.first_name,
          last_name: tgUser.last_name || '',
          username: tgUser.username || '',
          photo_url: tgUser.photo_url || ''
        })
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          window.location.href = data.redirect || '/dashboard';
        }
      })
      .catch(err => {
        console.error('Auto login error:', err);
        document.getElementById('webapp-status').classList.add('hidden');
        document.getElementById('browser-login-options').classList.remove('hidden');
      });
    } else {
      // 2. Poll for Deep Link Login approval every 2 seconds
      const pollInterval = setInterval(() => {
        fetch('/api/auth/check-session/' + sessionCode)
          .then(res => res.json())
          .then(data => {
            if (data.status === 'APPROVED') {
              clearInterval(pollInterval);
              window.location.href = data.redirect || '/dashboard';
            }
          })
          .catch(e => console.log('Session poll error:', e));
      }, 2000);
    }

    // Demo Instant Login
    function demoLogin() {
      fetch('/api/auth/webapp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          id: 99887766,
          first_name: 'Alisher',
          last_name: 'Navoiy',
          username: 'demo_user',
          photo_url: ''
        })
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          window.location.href = '/dashboard';
        }
      });
    }
  </script>
</body>
</html>
