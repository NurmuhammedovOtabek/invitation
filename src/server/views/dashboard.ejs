<!DOCTYPE html>
<html lang="uz">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mening Taklifnomalarim — Shaxsiy Kabinet</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <link rel="stylesheet" href="/css/animations.css">
  <style>
    body {
      background-color: #080c14;
      color: #f8fafc;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col items-center justify-start selection:bg-amber-500 selection:text-slate-950 font-sans pb-16">

  <!-- TOP NAVIGATION HEADER -->
  <header class="w-full bg-slate-900/90 border-b border-slate-800 sticky top-0 z-30 backdrop-blur-md">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between">
      
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-2">
          <div class="w-9 h-9 rounded-xl bg-gold-luxury flex items-center justify-center text-slate-950 font-bold shadow-md shadow-amber-500/20">
            <i data-lucide="mail-open" class="w-5 h-5"></i>
          </div>
          <span class="font-serif-luxury font-bold text-lg text-white hidden sm:inline">Taklifnoma.uz</span>
        </a>
      </div>

      <!-- User Profile & Action -->
      <div class="flex items-center gap-3">
        <div class="flex items-center gap-2.5 bg-slate-950/60 border border-slate-800 px-3 py-1.5 rounded-full">
          <div class="w-7 h-7 rounded-full bg-amber-500/20 text-amber-300 font-bold text-xs flex items-center justify-center border border-amber-500/40">
            <%= (user.first_name || 'U').charAt(0).toUpperCase() %>
          </div>
          <span class="text-xs font-semibold text-white max-w-[120px] truncate"><%= user.first_name || user.username || 'Foydalanuvchi' %></span>
        </div>

        <a href="/builder" class="py-2 px-3.5 rounded-xl bg-gold-luxury text-slate-950 font-bold text-xs shadow-md shadow-amber-500/20 flex items-center gap-1.5 hover:brightness-110 active:scale-95 transition-all">
          <i data-lucide="plus" class="w-4 h-4"></i> <span class="hidden sm:inline">Yangi Taklifnoma</span>
        </a>

        <a href="/auth/logout" class="p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-gray-400 hover:text-red-400 border border-slate-700 transition-all" title="Chiqish">
          <i data-lucide="log-out" class="w-4 h-4"></i>
        </a>
      </div>

    </div>
  </header>

  <!-- MAIN CONTAINER -->
  <main class="w-full max-w-5xl px-4 sm:px-6 pt-8 space-y-8">
    
    <!-- Welcome Banner & Quick Stats -->
    <div class="space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="font-serif-luxury font-bold text-2xl sm:text-3xl text-white">Mening Taklifnomalarim</h1>
          <p class="text-xs text-gray-400 mt-1">Siz yaratgan barcha doimiy onlayn taklifnomalar va statistika</p>
        </div>
      </div>

      <!-- 3 Stat Metric Cards -->
      <div class="grid grid-cols-3 gap-3 sm:gap-4">
        <div class="p-4 rounded-2xl bg-slate-900/80 border border-slate-800/80 space-y-1">
          <span class="text-[11px] text-gray-400 flex items-center gap-1.5">
            <i data-lucide="mail" class="w-3.5 h-3.5 text-amber-400"></i> Jami Taklifnomalar
          </span>
          <span class="text-xl sm:text-2xl font-bold font-serif-luxury text-white block"><%= stats.totalInvites %> ta</span>
        </div>

        <div class="p-4 rounded-2xl bg-slate-900/80 border border-slate-800/80 space-y-1">
          <span class="text-[11px] text-gray-400 flex items-center gap-1.5">
            <i data-lucide="eye" class="w-3.5 h-3.5 text-blue-400"></i> Mehmonlar Ko'rishi
          </span>
          <span class="text-xl sm:text-2xl font-bold font-serif-luxury text-amber-300 block"><%= stats.totalViews %> marta</span>
        </div>

        <div class="p-4 rounded-2xl bg-slate-900/80 border border-slate-800/80 space-y-1">
          <span class="text-[11px] text-gray-400 flex items-center gap-1.5">
            <i data-lucide="check-circle" class="w-3.5 h-3.5 text-emerald-400"></i> Faol Havolalar
          </span>
          <span class="text-xl sm:text-2xl font-bold font-serif-luxury text-emerald-400 block"><%= stats.activeInvites %> ta</span>
        </div>
      </div>
    </div>

    <!-- INVITATIONS LIST / HISTORY -->
    <div class="space-y-4">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <h2 class="text-sm font-semibold text-gray-300 flex items-center gap-2">
          <i data-lucide="history" class="w-4 h-4 text-amber-400"></i> Taklifnomalar Tarixi
        </h2>
        <span class="text-xs text-gray-500"><%= invitations.length %> ta yaratilgan</span>
      </div>

      <% if (invitations.length === 0) { %>
        <!-- Empty State -->
        <div class="p-12 text-center rounded-3xl bg-slate-900/40 border border-slate-800/60 space-y-4">
          <div class="w-16 h-16 rounded-2xl bg-slate-800/60 border border-slate-700 flex items-center justify-center mx-auto text-gray-500">
            <i data-lucide="inbox" class="w-8 h-8"></i>
          </div>
          <div class="space-y-1">
            <h3 class="text-base font-bold text-white">Sizda hali taklifnomalar mavjud emas</h3>
            <p class="text-xs text-gray-400 max-w-sm mx-auto">Lego Konstruktordan foydalanib, 2 daqiqada birinchi mukammal taklifnomangizni yarating!</p>
          </div>
          <a href="/builder" class="inline-flex items-center gap-2 py-3 px-6 rounded-2xl bg-gold-luxury text-slate-950 font-bold text-xs shadow-lg shadow-amber-500/20 hover:brightness-110 transition-all">
            <i data-lucide="sparkles" class="w-4 h-4"></i> Birinchi Taklifnomani Yaratish
          </a>
        </div>
      <% } else { %>
        
        <!-- Cards Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <% invitations.forEach(inv => { %>
            <div class="p-5 rounded-3xl bg-slate-900/90 border border-slate-800 hover:border-amber-500/40 transition-all shadow-xl space-y-4 flex flex-col justify-between">
              
              <div class="space-y-3">
                
                <!-- Card Header -->
                <div class="flex items-start justify-between gap-3">
                  <div>
                    <span class="text-[10px] uppercase font-bold tracking-wider px-2.5 py-1 rounded-full bg-amber-500/15 text-amber-300 border border-amber-500/30">
                      <%= inv.event_type || 'Nikoh To\'yi' %>
                    </span>
                    <h3 class="font-serif-luxury font-bold text-xl text-white mt-2">
                      <%= inv.groom_name %>
                    </h3>
                  </div>

                  <!-- Status Badge -->
                  <% if (inv.is_active === 1) { %>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 text-[11px] font-semibold">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> Faol
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-amber-500/10 text-amber-300 border border-amber-500/30 text-[11px] font-semibold">
                      <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span> Kutilmoqda
                    </span>
                  <% } %>
                </div>

                <!-- Event Details -->
                <div class="text-xs text-gray-400 space-y-1.5 pt-1">
                  <p class="flex items-center gap-2">
                    <i data-lucide="calendar" class="w-3.5 h-3.5 text-amber-400"></i>
                    <span>Sana: <strong class="text-gray-200"><%= inv.formattedDate || inv.event_date %></strong></span>
                  </p>
                  <p class="flex items-center gap-2">
                    <i data-lucide="map-pin" class="w-3.5 h-3.5 text-amber-400"></i>
                    <span class="truncate">To'yxona: <strong class="text-gray-200"><%= inv.venue_name || 'Ko\'rsatilmagan' %></strong></span>
                  </p>
                  <p class="flex items-center gap-2">
                    <i data-lucide="eye" class="w-3.5 h-3.5 text-blue-400"></i>
                    <span>Ko'rishlar soni: <strong class="text-blue-300"><%= inv.views_count || 0 %> marta</strong></span>
                  </p>
                </div>

                <!-- Live Permanent Link Box -->
                <div class="p-2.5 rounded-2xl bg-slate-950 border border-slate-800 flex items-center justify-between gap-2">
                  <span class="text-[11px] font-mono text-gray-400 truncate max-w-[220px]">
                    <%= inv.liveUrl %>
                  </span>
                  <button onclick="copyToClipboard('<%= inv.liveUrl %>')" class="p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-amber-300 text-xs flex items-center gap-1 transition-all active:scale-90" title="Nusxalash">
                    <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                  </button>
                </div>

              </div>

              <!-- Card Action Buttons -->
              <div class="pt-3 border-t border-slate-800/80 grid grid-cols-2 gap-2">
                <a href="<%= inv.liveUrl %>" target="_blank" class="py-2.5 px-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-semibold text-xs text-center flex items-center justify-center gap-1.5 transition-all">
                  <i data-lucide="external-link" class="w-3.5 h-3.5 text-amber-400"></i> Ochib Ko'rish
                </a>

                <a href="https://t.me/share/url?url=<%= encodeURIComponent(inv.liveUrl) %>&text=<%= encodeURIComponent('Sizni to\'yimizga lutfan taklif etamiz! ✨') %>" target="_blank" class="py-2.5 px-3 rounded-xl bg-sky-600 hover:bg-sky-500 text-white font-bold text-xs text-center flex items-center justify-center gap-1.5 shadow-md shadow-sky-600/20 transition-all">
                  <i data-lucide="send" class="w-3.5 h-3.5"></i> Ulashish
                </a>
              </div>

            </div>
          <% }) %>
        </div>

      <% } %>
    </div>

  </main>

  <!-- Toast Alert Box -->
  <div id="toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 px-4 py-2 bg-amber-500 text-slate-950 text-xs font-bold rounded-full shadow-lg opacity-0 transition-opacity duration-300 pointer-events-none z-50">
    ✅ Havola nusxalandi!
  </div>

  <script>
    lucide.createIcons();

    function copyToClipboard(text) {
      navigator.clipboard.writeText(text).then(() => {
        const toast = document.getElementById('toast');
        toast.classList.remove('opacity-0');
        toast.classList.add('opacity-100');
        setTimeout(() => {
          toast.classList.remove('opacity-100');
          toast.classList.add('opacity-0');
        }, 2500);
      });
    }
  </script>
</body>
</html>
