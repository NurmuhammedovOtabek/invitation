<!DOCTYPE html>
<html lang="uz">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Online Taklifnomalar — Zamonaviy To'y Taklifnomalari</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <link rel="stylesheet" href="/css/animations.css">
  <style>
    body {
      background: radial-gradient(circle at top, #0f172a 0%, #020617 100%);
      color: #f8fafc;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col items-center justify-between selection:bg-amber-500 selection:text-slate-950">

  <!-- Header -->
  <header class="w-full max-w-5xl px-6 py-6 flex justify-between items-center border-b border-slate-800">
    <div class="flex items-center gap-2">
      <div class="w-10 h-10 rounded-xl bg-gold-luxury flex items-center justify-center text-slate-950 font-bold shadow-lg shadow-amber-500/30">
        <i data-lucide="sparkles" class="w-5 h-5"></i>
      </div>
      <div>
        <span class="font-serif-luxury font-bold text-lg text-white">Taklifnoma<span class="text-amber-400">.uz</span></span>
        <span class="block text-[10px] text-gray-400 tracking-wider">ONLINE TAKLIFNOMALAR</span>
      </div>
    </div>

    <a href="https://t.me" target="_blank" class="px-5 py-2.5 rounded-full bg-gold-luxury text-slate-950 font-bold text-xs shadow-lg shadow-amber-500/20 hover:brightness-110 active:scale-95 transition-all flex items-center gap-2">
      <i data-lucide="bot" class="w-4 h-4"></i> Telegram Botni ochish
    </a>
  </header>

  <!-- Hero -->
  <main class="w-full max-w-4xl px-6 py-12 flex flex-col items-center text-center space-y-8">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs font-semibold">
      <i data-lucide="zap" class="w-3.5 h-3.5"></i> 2 daqiqada tayyor bo'ladigan taklifnomalar
    </div>

    <h1 class="text-3xl md:text-5xl lg:text-6xl font-serif-luxury font-bold text-white max-w-2xl leading-tight">
      To'y va marosimlaringiz uchun <span class="text-gold-luxury">Eng Nafis Veb-Taklifnomalar</span>
    </h1>

    <p class="text-gray-400 max-w-xl text-sm md:text-base font-light">
      Qog'oz taklifnomalarni unuting! Mehmonlaringizga musiqali, animatsiyali, jonli hisoblagich va xaritaga ega zamonaviy veb-havolani yuboring.
    </p>

    <!-- Templates Grid -->
    <div class="w-full pt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 text-left">
      <!-- Card 1 -->
      <div class="glass-card p-5 border-amber-500/30 hover:border-amber-400 transition-all flex flex-col justify-between space-y-4">
        <div class="space-y-2">
          <div class="w-10 h-10 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center">
            <i data-lucide="crown" class="w-5 h-5"></i>
          </div>
          <h3 class="font-serif-luxury font-bold text-lg text-white">Classic Luxury</h3>
          <p class="text-xs text-gray-400">Zangori-yashil va oltin naqshlar uyg'unligidagi shohona klassika.</p>
        </div>
        <a href="/preview/classic_luxury" target="_blank" class="w-full py-2 px-3 rounded-lg bg-white/10 hover:bg-white/20 text-amber-300 text-xs font-semibold text-center block transition-all">
          Jonli ko'rish ↗
        </a>
      </div>

      <!-- Card 2 -->
      <div class="glass-card p-5 border-pink-500/30 hover:border-pink-400 transition-all flex flex-col justify-between space-y-4">
        <div class="space-y-2">
          <div class="w-10 h-10 rounded-xl bg-pink-500/20 text-pink-400 flex items-center justify-center">
            <i data-lucide="heart" class="w-5 h-5"></i>
          </div>
          <h3 class="font-serif-luxury font-bold text-lg text-white">Modern Romantic</h3>
          <p class="text-xs text-gray-400">Nozik pushti gullar, zamonaviy shriftlar va romantik musiqa.</p>
        </div>
        <a href="/preview/modern_romantic" target="_blank" class="w-full py-2 px-3 rounded-lg bg-white/10 hover:bg-white/20 text-pink-300 text-xs font-semibold text-center block transition-all">
          Jonli ko'rish ↗
        </a>
      </div>

      <!-- Card 3 -->
      <div class="glass-card p-5 border-blue-500/30 hover:border-blue-400 transition-all flex flex-col justify-between space-y-4">
        <div class="space-y-2">
          <div class="w-10 h-10 rounded-xl bg-blue-500/20 text-blue-400 flex items-center justify-center">
            <i data-lucide="moon" class="w-5 h-5"></i>
          </div>
          <h3 class="font-serif-luxury font-bold text-lg text-white">Royal Night</h3>
          <p class="text-xs text-gray-400">Sharqona moviy kecha va oltin naqshlar jilosi.</p>
        </div>
        <a href="/preview/royal_night" target="_blank" class="w-full py-2 px-3 rounded-lg bg-white/10 hover:bg-white/20 text-blue-300 text-xs font-semibold text-center block transition-all">
          Jonli ko'rish ↗
        </a>
      </div>

      <!-- Card 4 -->
      <div class="glass-card p-5 border-emerald-500/30 hover:border-emerald-400 transition-all flex flex-col justify-between space-y-4">
        <div class="space-y-2">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center">
            <i data-lucide="party-popper" class="w-5 h-5"></i>
          </div>
          <h3 class="font-serif-luxury font-bold text-lg text-white">Sunnat To'yi</h3>
          <p class="text-xs text-gray-400">Bolajonlar sunnat to'yi va quvonchli bayramlar uchun.</p>
        </div>
        <a href="/preview/sunnat_toy" target="_blank" class="w-full py-2 px-3 rounded-lg bg-white/10 hover:bg-white/20 text-emerald-300 text-xs font-semibold text-center block transition-all">
          Jonli ko'rish ↗
        </a>
      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer class="w-full max-w-5xl px-6 py-8 border-t border-slate-800 text-center text-xs text-gray-500">
    <p>© <%= new Date().getFullYear() %> Online Taklifnomalar. Barcha huquqlar himoyalangan.</p>
  </footer>

  <script>lucide.createIcons();</script>
</body>
</html>
