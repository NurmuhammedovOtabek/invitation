{
  "version": 2,
  "cleanUrls": true,
  "buildCommand": "echo 'Static build ready'",
  "installCommand": "echo 'Skipping npm install for ultra-fast static deployment'",
  "rewrites": [
    { "source": "/emerald", "destination": "/templates/emerald.html" },
    { "source": "/rose", "destination": "/templates/rose.html" },
    { "source": "/midnight", "destination": "/templates/midnight.html" },
    { "source": "/luxury", "destination": "/templates/luxury.html" },
    { "source": "/audio/(.*)", "destination": "/public/audio/$1" },
    { "source": "/css/(.*)", "destination": "/public/css/$1" },
    { "source": "/js/(.*)", "destination": "/public/js/$1" },
    { "source": "/templates/(.*)", "destination": "/public/templates/$1" }
  ]
}
